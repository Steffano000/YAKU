<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#154204">
<style>:root{padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}[hidden]{display:none!important}</style>
</head>
<body>
<title>Yaku</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap">
<style>
:root{
  --bg:#ffffff; --surface:#ffffff; --sage:#eef6eb; --ochre:#fbf5e6; --line:#dbe7d5;
  --ink:#1a2215; --muted:#4a5544; --primary:#2d5a1b; --primary-deep:#154204; --on-primary:#ffffff;
  --primary-text:#2d5a1b;
  --verde:#1f8578; --amarillo:#e0a526; --rojo:#c8402f; --descanso:#5f6f52;
  --on-verde:#ffffff; --on-amarillo:#1a2215; --on-rojo:#ffffff; --on-descanso:#ffffff;
  --verde-text:#1f8578; --amarillo-text:#7a5500; --rojo-text:#b23a2a; --descanso-text:#4f5d44;
  --verde-tint:#e6f5f3; --amarillo-tint:#fdf6e3; --rojo-tint:#faecea; --descanso-tint:#eef1ea;
  --shadow:0 4px 12px rgba(45,90,27,.08);
  --radius:22px;
  --font:"Plus Jakarta Sans", system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#0f140c; --surface:#182013; --sage:#1f2a19; --ochre:#2a2615; --line:#2c3a26;
  --ink:#edf3e8; --muted:#a9b6a1; --primary:#3f7a28; --primary-deep:#2d5a1b; --primary-text:#a0d587;
  --verde-text:#5cc7b6; --amarillo-text:#f0c35a; --rojo-text:#f08a7a; --descanso-text:#b9c6ae;
  --verde-tint:#13302b; --amarillo-tint:#33290f; --rojo-tint:#3a1a15; --descanso-tint:#20281b;
  --shadow:0 4px 12px rgba(0,0,0,.35);
}
*{box-sizing:border-box}
html,body{background:var(--bg)}
body{margin:0;color:var(--ink);font-family:var(--font);font-size:18px;line-height:1.45;-webkit-font-smoothing:antialiased}
button{font:inherit;color:inherit}
button:focus-visible,[tabindex]:focus-visible{outline:3px solid var(--primary-text);outline-offset:3px}
h1,h2,h3{margin:0;text-wrap:balance;line-height:1.15}
p{margin:0}

/* ---------- estructura ---------- */
.top{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.top-in{max-width:480px;margin:0 auto;padding:12px 20px;display:flex;align-items:center;gap:12px}
.logo{width:40px;height:40px;flex:none}
.marca{display:flex;flex-direction:column;min-width:0}
.marca b{font-size:24px;font-weight:800;color:var(--primary-text);letter-spacing:-.01em;line-height:1}
.marca small{font-size:13px;font-weight:600;color:var(--muted);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.datos-pill{margin-left:auto;display:none;font-size:12px;font-weight:700;color:var(--muted);background:var(--sage);border:1px solid var(--line);border-radius:999px;padding:5px 10px;white-space:nowrap}
main{max-width:480px;margin:0 auto;padding-inline:20px;padding-block:18px 128px;display:flex;flex-direction:column;gap:16px}
.nav{position:fixed;left:0;right:0;bottom:0;z-index:6;background:var(--surface);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom,0px)}
.nav-in{max-width:480px;margin:0 auto;padding:10px 20px;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.tab{min-height:62px;border:0;border-radius:18px;background:var(--sage);display:flex;align-items:center;justify-content:center;gap:10px;font-size:17px;font-weight:700;color:var(--muted);cursor:pointer}
.tab svg{width:28px;height:28px}
.tab[aria-current="page"]{background:var(--primary-deep);color:#fff}
.tema{margin-left:auto;width:48px;height:48px;flex:none;border-radius:50%;border:2px solid var(--line);background:var(--sage);color:var(--primary-text);display:grid;place-items:center;cursor:pointer}
.tema svg{width:24px;height:24px}
@media (min-width:420px){.datos-pill{display:inline-block}.tema{margin-left:0}}

/* avisos al celular */
.avisos{padding:18px;display:flex;flex-direction:column;gap:12px}
.avisos h3{font-size:21px;font-weight:800;color:var(--primary-text);display:flex;gap:10px;align-items:center}
.avisos h3 svg{width:28px;height:28px}
.avisos p{font-size:17px;color:var(--muted);font-weight:600}
.campo{display:flex;flex-direction:column;gap:6px}
.campo label{font-size:17px;font-weight:800}
.tel{display:flex;align-items:center;border:2px solid var(--line);border-radius:16px;background:var(--surface);overflow:hidden}
.tel:focus-within{border-color:var(--primary)}
.tel span{padding:0 12px 0 16px;font-size:22px;font-weight:800;color:var(--muted);border-right:2px solid var(--line)}
.tel input{flex:1;min-width:0;border:0;background:transparent;color:var(--ink);font:inherit;font-size:26px;font-weight:800;letter-spacing:.06em;padding:14px 12px;font-variant-numeric:tabular-nums}
.tel input:focus{outline:none}
.consent{display:flex;gap:12px;align-items:flex-start;background:var(--sage);border-radius:16px;padding:14px;cursor:pointer}
.consent input{width:28px;height:28px;flex:none;margin:2px 0 0;accent-color:var(--primary-deep)}
.consent span{font-size:17px;font-weight:600}
.error{color:var(--rojo-text);font-size:16px;font-weight:700}
.piloto{font-size:14px;color:var(--muted);font-weight:600;background:var(--ochre);border-radius:12px;padding:10px 12px}
.registrado{display:flex;align-items:center;gap:12px;background:var(--verde-tint);border-radius:16px;padding:14px}
.registrado svg{width:30px;height:30px;color:var(--verde-text);flex:none}
.registrado b{display:block;font-size:19px}
.registrado small{display:block;font-size:15px;color:var(--muted);font-weight:600}

/* ---------- piezas ---------- */
.titulo-pantalla{font-size:30px;font-weight:800;color:var(--primary-text);letter-spacing:-.02em}
.sub{color:var(--muted);font-size:18px}
.btn{min-height:60px;width:100%;border-radius:18px;border:0;border-bottom:3px solid rgba(0,0,0,.22);display:flex;align-items:center;justify-content:center;gap:12px;font-size:20px;font-weight:800;cursor:pointer;transition:transform .08s}
.btn:active{transform:translateY(2px)}
.btn svg{width:30px;height:30px;flex:none}
.btn-prim{background:var(--primary-deep);color:#fff}
.btn-audio{background:var(--primary);color:#fff}
.btn-suave{background:var(--sage);color:var(--primary-text);border-bottom-color:var(--line)}
.btn[disabled]{opacity:.55;cursor:default}
.card{background:var(--surface);border:2px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}

/* contexto del cultivo */
.contexto{display:flex;align-items:center;gap:12px;padding:12px 16px;background:var(--sage);border-radius:18px}
.contexto .emo{font-size:34px;line-height:1}
.contexto div{min-width:0}
.contexto b{display:block;font-size:19px;color:var(--primary-text)}
.contexto small{display:block;font-size:15px;color:var(--muted);font-weight:600}
.link{margin-left:auto;background:none;border:0;padding:8px 4px;font-size:17px;font-weight:800;color:var(--primary-text);text-decoration:underline;text-decoration-thickness:2px;text-underline-offset:4px;cursor:pointer}

/* tarjeta grande de estado */
.estado{border-radius:26px;padding:20px 20px 24px;text-align:center;display:flex;flex-direction:column;align-items:center;gap:6px;position:relative;overflow:hidden}
.estado.verde{background:var(--verde);color:var(--on-verde)}
.estado.amarillo{background:var(--amarillo);color:var(--on-amarillo)}
.estado.rojo{background:var(--rojo);color:var(--on-rojo)}
.estado.descanso{background:var(--descanso);color:var(--on-descanso)}
.estado .fila-sup{width:100%;display:flex;justify-content:space-between;align-items:center;gap:8px;font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
.estado .pill{background:rgba(255,255,255,.22);border-radius:999px;padding:5px 12px;display:inline-flex;align-items:center;gap:6px}
.estado.amarillo .pill{background:rgba(26,34,21,.12)}
.estado .pill i{width:9px;height:9px;border-radius:50%;background:currentColor;display:inline-block}
.estado .mes{font-size:42px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;line-height:1;margin-top:8px}
.estado .dibujo{width:124px;height:124px;margin:6px 0}
.estado h2{font-size:32px;font-weight:800;letter-spacing:-.01em}
.estado .frase{font-size:21px;font-weight:700;opacity:.96}
.estado .clima-valle{margin-top:10px;background:rgba(255,255,255,.18);border-radius:14px;padding:8px 14px;font-size:16px;font-weight:700;display:inline-flex;align-items:center;gap:8px}
.estado .clima-valle i{width:12px;height:12px;border-radius:50%;display:inline-block;border:2px solid rgba(255,255,255,.8)}

/* qué hago */
.quehago{padding:18px;display:flex;flex-direction:column;gap:12px}
.quehago h3{font-size:24px;font-weight:800;color:var(--primary-text);display:flex;align-items:center;gap:10px}
.quehago h3 svg{width:28px;height:28px}
.consejo{display:flex;gap:14px;align-items:flex-start;background:var(--sage);border-radius:16px;padding:14px}
.consejo .ico{width:48px;height:48px;border-radius:14px;flex:none;display:grid;place-items:center;background:var(--surface);color:var(--primary-text)}
.consejo .ico svg{width:28px;height:28px}
.consejo small{display:block;font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;color:var(--muted);margin-bottom:2px}
.consejo p{font-size:19px;font-weight:600}
.consejo.aviso{background:var(--ochre)}
.consejo.aviso .ico{color:var(--amarillo-text)}

/* elegir cultivo */
.cultivos{display:flex;flex-direction:column;gap:12px}
.cult{display:flex;align-items:center;gap:16px;padding:14px 16px;text-align:left;cursor:pointer;width:100%}
.cult .emo{font-size:46px;width:64px;height:64px;display:grid;place-items:center;background:var(--sage);border-radius:18px;flex:none}
.cult b{display:block;font-size:24px;font-weight:800}
.cult small{display:block;font-size:15px;color:var(--muted);font-weight:600}
.cult .check{margin-left:auto;width:34px;height:34px;border-radius:50%;border:3px solid var(--line);flex:none;display:grid;place-items:center}
.cult[aria-checked="true"]{border-color:var(--primary);background:color-mix(in srgb,var(--sage) 60%,var(--surface))}
.cult[aria-checked="true"] .check{background:var(--primary-deep);border-color:var(--primary-deep);color:#fff}
.cult .check svg{width:20px;height:20px}
.meses-card{padding:18px;display:flex;flex-direction:column;gap:12px}
.meses-card h3{font-size:21px;font-weight:800;display:flex;gap:10px;align-items:center}
.meses-card h3 svg{width:26px;height:26px;color:var(--primary-text)}
.chips{display:flex;flex-wrap:wrap;gap:10px}
.chip{min-height:54px;min-width:74px;padding:0 16px;border-radius:14px;border:2px solid var(--line);background:var(--sage);font-size:20px;font-weight:800;color:var(--primary-text);cursor:pointer}
.chip[aria-checked="true"]{background:var(--primary-deep);border-color:var(--primary-deep);color:#fff}
.nota{font-size:15px;color:var(--muted);font-weight:600}
.otro{align-self:flex-start;background:none;border:0;padding:6px 0;font-size:17px;font-weight:800;color:var(--primary-text);text-decoration:underline;text-underline-offset:4px;cursor:pointer}

/* próximos meses */
.pista{display:flex;gap:10px;align-items:center;background:var(--sage);border-radius:14px;padding:12px 14px;font-size:16px;font-weight:600;color:var(--muted)}
.pista svg{width:24px;height:24px;flex:none}
.lista{display:flex;flex-direction:column;gap:12px}
.fila{overflow:hidden;border-left-width:8px}
.fila.verde{border-left-color:var(--verde)} .fila.amarillo{border-left-color:var(--amarillo)}
.fila.rojo{border-left-color:var(--rojo)} .fila.descanso{border-left-color:var(--descanso)}
.fila-btn{width:100%;display:flex;align-items:center;gap:14px;padding:14px 14px 14px 12px;background:none;border:0;text-align:left;cursor:pointer}
.circ{width:58px;height:58px;border-radius:50%;flex:none;display:grid;place-items:center}
.circ svg{width:40px;height:40px}
.verde .circ{background:var(--verde-tint);color:var(--verde-text)}
.amarillo .circ{background:var(--amarillo-tint);color:var(--amarillo-text)}
.rojo .circ{background:var(--rojo-tint);color:var(--rojo-text)}
.descanso .circ{background:var(--descanso-tint);color:var(--descanso-text)}
.fila-txt{min-width:0;flex:1}
.fila-txt b{font-size:22px;font-weight:800;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.fila-txt b em{font-style:normal;font-size:14px;color:var(--muted);font-weight:700}
.badge{font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;background:var(--primary-deep);color:#fff;border-radius:999px;padding:3px 9px}
.fila-txt span{display:block;font-size:17px;font-weight:700}
.verde .fila-txt span{color:var(--verde-text)} .amarillo .fila-txt span{color:var(--amarillo-text)}
.rojo .fila-txt span{color:var(--rojo-text)} .descanso .fila-txt span{color:var(--descanso-text)}
.chev{width:28px;height:28px;flex:none;color:var(--muted);transition:transform .15s}
.fila[data-open="true"] .chev{transform:rotate(180deg)}
.detalle{padding:0 14px 16px;display:flex;flex-direction:column;gap:10px}
.detalle .consejo p{font-size:17px}
.detalle .btn{min-height:52px;font-size:17px}
.detalle .btn svg{width:24px;height:24px}
.pie{display:flex;gap:12px;align-items:flex-start;background:var(--sage);border-radius:16px;padding:14px 16px;font-size:15px;color:var(--muted);font-weight:600}
.pie svg{width:26px;height:26px;flex:none;color:var(--primary-text)}
@media (prefers-reduced-motion: reduce){*{transition:none!important}}

.perfil{width:48px;height:48px;flex:none;border-radius:50%;border:2px solid var(--line);background:var(--sage);color:var(--primary-text);display:grid;place-items:center;cursor:pointer}
.perfil svg{width:26px;height:26px}
.qu{display:block}
.es2{display:block;font-size:.82em;font-weight:600;opacity:.8;margin-top:4px}
.estado .es2{opacity:.92}
.banner{display:flex;gap:12px;align-items:center;border-radius:18px;padding:14px;border:3px solid var(--rojo);background:var(--rojo-tint);text-align:left;width:100%;cursor:pointer}
.banner.helada{border-color:var(--verde);background:var(--verde-tint)}
.banner .bico{width:46px;height:46px;border-radius:50%;flex:none;display:grid;place-items:center;background:var(--surface);color:var(--rojo-text)}
.banner.helada .bico{color:var(--verde-text)}
.banner .bico svg{width:28px;height:28px}
.banner p{font-size:18px;font-weight:700;flex:1;min-width:0}
.banner small{display:block;font-size:15px;font-weight:800;color:var(--primary-text);text-decoration:underline;text-underline-offset:3px;margin-top:4px}
.idiomas{display:flex;flex-direction:column;gap:12px}
.idioma{min-height:76px;display:flex;align-items:center;gap:14px;padding:12px 18px;text-align:left;cursor:pointer;width:100%}
.idioma b{display:block;font-size:24px;font-weight:800}
.idioma small{display:block;font-size:15px;color:var(--muted);font-weight:600}
.idioma .check{margin-left:auto;width:34px;height:34px;border-radius:50%;border:3px solid var(--line);flex:none;display:grid;place-items:center}
.idioma[aria-checked="true"]{border-color:var(--primary)}
.idioma[aria-checked="true"] .check{background:var(--primary-deep);border-color:var(--primary-deep);color:#fff}
.idioma .check svg{width:20px;height:20px}
.chips-idioma{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.chips-idioma .chip{min-width:0;padding:0 6px;font-size:17px}
.txt{border:2px solid var(--line);border-radius:16px;background:var(--surface);color:var(--ink);font:inherit;font-size:22px;font-weight:700;padding:14px 16px;width:100%}
.txt:focus{outline:none;border-color:var(--primary)}
.nota-qu{background:var(--ochre);border-radius:14px;padding:10px 14px;font-size:15px;font-weight:700;color:var(--muted)}
.toast{position:fixed;left:50%;transform:translateX(-50%);bottom:calc(96px + env(safe-area-inset-bottom,0px));z-index:9;max-width:440px;width:calc(100% - 40px);background:var(--ink);color:var(--bg);border-radius:14px;padding:12px 16px;font-size:16px;font-weight:700;box-shadow:var(--shadow)}
.guardado{color:var(--verde-text);font-weight:800;font-size:17px}
</style>

<header class="top">
  <div class="top-in">
    <svg class="logo" viewBox="0 0 40 40" aria-hidden="true"><rect width="40" height="40" rx="12" fill="#2d5a1b"/><path d="M20 7c5.5 7 9 11.6 9 16.2A9 9 0 0 1 11 23.2C11 18.6 14.5 14 20 7z" fill="#97f3e3"/><path d="M20 31v-9m0 3c-2.6 0-4.5-1.6-4.8-4.2 2.7 0 4.5 1.5 4.8 4.2zm0-2c.3-2.8 2.2-4.4 4.8-4.4-.3 2.7-2.1 4.4-4.8 4.4z" stroke="#154204" stroke-width="1.8" fill="#154204" stroke-linejoin="round"/></svg>
    <div class="marca"><b>Yaku</b><small id="zona"></small></div>
    <span class="datos-pill" id="datos-pill"></span>
    <button class="tema" id="btn-tema" type="button" aria-label="Cambiar a modo oscuro"></button>
    <button class="perfil" id="btn-perfil" type="button" data-ir="datos" aria-label="Mis datos"></button>
  </div>
</header>

<main id="app" aria-live="polite"></main>
<div class="toast" id="toast" role="status" hidden></div>

<nav class="nav" id="nav" aria-label="Secciones">
  <div class="nav-in">
    <button class="tab" id="tab-mes" data-ir="mes" type="button"></button>
    <button class="tab" id="tab-prox" data-ir="proximos" type="button"></button>
  </div>
</nav>

<script src="datos.js"></script>
<script>
(function(){
  "use strict";
  var D = window.YAKU_DATOS;
  var app = document.getElementById("app");
  if (!D) { app.innerHTML = '<p class="card" style="padding:18px">No se encontraron los datos (datos.js). Vuelve a generar la app con 02_scripts/00_generar_todo.py.</p>'; return; }

  var PIEZAS = D.mensajes.piezas;
  var RIEGO_QU = D.mensajes.riego_qu || {};
  var UI = D.ui || {};
  var CULTS = D.cultivos.cultivos;
  var REC = D.recomendaciones.cultivos;

  var I = {
    gota:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M12 3c3.8 4.6 6.2 8 6.2 11.2a6.2 6.2 0 0 1-12.4 0C5.8 11 8.2 7.6 12 3z"/></svg>',
    planta:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21v-8"/><path d="M12 13c-4 0-6.5-2.4-7-6.5 4.1.3 6.6 2.6 7 6.5z"/><path d="M12 11c.4-3.9 2.9-6.2 7-6.5-.5 4.1-3 6.5-7 6.5z"/><path d="M6 21h12"/></svg>',
    parlante:'<svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 9.5h3.5L12 5.5v13l-4.5-4H4z"/><path d="M15.5 8.5a5 5 0 0 1 0 7M18 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>',
    parar:'<svg viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12" rx="2.5"/></svg>',
    calendario:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><rect x="3.5" y="5" width="17" height="15.5" rx="3"/><path d="M3.5 10h17M8 3v4M16 3v4"/></svg>',
    casa:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M12 3c3.8 4.6 6.2 8 6.2 11.2a6.2 6.2 0 0 1-12.4 0C5.8 11 8.2 7.6 12 3z"/></svg>',
    pregunta:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.3a2.6 2.6 0 1 1 3.4 2.5c-.6.2-.9.7-.9 1.3v.6"/><circle cx="12" cy="17" r=".6" fill="currentColor"/></svg>',
